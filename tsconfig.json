{
    "compilerOptions": {
        "target": "es5",
        "module": "none",
        "moduleResolution": "node",
        "outFile": "./build/build.js",
        "rootDir": "./sketch/",
        "sourceMap": true,
        
        "strict": true,
        "exactOptionalPropertyTypes": true,

        "noImplicitAny": true,
        "noImplicitOverride": true,
        "preserveConstEnums": false,
        "strictNullChecks": true,
        "removeComments": true
    }
}